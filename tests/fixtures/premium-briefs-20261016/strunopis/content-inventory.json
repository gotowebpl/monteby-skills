  "entries": [
    { "id": "brand", "text": "Strunopis", "expectedOccurrences": 2, "uses": [{ "region": "navigation", "role": "brand" }, { "region": "footer", "role": "brand" }] },
    { "id": "menu-label", "text": "Na tej stronie", "expectedOccurrences": 1, "uses": [{ "region": "navigation", "role": "menu-accessible-label" }] },
    { "id": "nav-approach", "text": "Podejście", "expectedOccurrences": 1, "uses": [{ "region": "navigation", "role": "link", "href": "#podejscie" }] },
    { "id": "nav-scope", "text": "Zakres", "expectedOccurrences": 1, "uses": [{ "region": "navigation", "role": "link", "href": "#zakres" }] },
    { "id": "nav-prepare", "text": "Przed rozmową", "expectedOccurrences": 1, "uses": [{ "region": "navigation", "role": "link", "href": "#przed-rozmowa" }] },
    { "id": "hero-eyebrow", "text": "PRACOWNIA INSTRUMENTÓW · KONCEPCJA DEMONSTRACYJNA", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "eyebrow" }] },
    { "id": "hero-title", "text": "Dobrze znany instrument. Nowa uważność.", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "heading", "level": 1 }] },
    { "id": "hero-body", "text": "Nie każdy problem słychać od razu. W Strunopisie zaczynamy od rozmowy o instrumencie i sposobie gry, a dopiero potem rozważamy zakres pracy.", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "lead" }] },
    { "id": "hero-action", "text": "Sprawdź, co przygotować", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "link", "href": "#przed-rozmowa" }] },
    { "id": "image-caption", "text": "Ilustracja koncepcyjna — nie dokumentacja rzeczywistego zlecenia.", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "media-caption" }] },
    { "id": "approach-title", "text": "Najpierw instrument. Potem decyzja.", "expectedOccurrences": 1, "uses": [{ "region": "approach", "role": "heading", "level": 2 }] },
    { "id": "approach-body", "text": "Interesuje nas nie tylko to, co wymaga zmiany, ale też to, co chcesz zachować: opór strun, ślady użytkowania i charakter brzmienia. Nie traktujemy każdego instrumentu tak samo.", "expectedOccurrences": 1, "uses": [{ "region": "approach", "role": "body" }] },
    { "id": "approach-statement", "text": "Dobra decyzja zaczyna się od uważnego słuchania.", "expectedOccurrences": 1, "uses": [{ "region": "approach", "role": "brand-statement-not-testimonial" }] },
    { "id": "scope-title", "text": "O czym możemy rozmawiać", "expectedOccurrences": 1, "uses": [{ "region": "scope", "role": "heading", "level": 2 }] },
    { "id": "scope-intro", "text": "Poniższy zakres opisuje fikcyjną pracownię. Nie zastępuje oględzin instrumentu ani indywidualnej oceny możliwości pracy.", "expectedOccurrences": 1, "uses": [{ "region": "scope", "role": "body" }] },
    { "id": "scope-regulation-title", "text": "Regulacja", "expectedOccurrences": 1, "uses": [{ "region": "scope-regulation", "role": "heading", "level": 3 }] },
    { "id": "scope-regulation-body", "text": "Rozmowa o wygodzie gry, ustawieniu instrumentu i tym, co zmieniło się w jego codziennym użytkowaniu.", "expectedOccurrences": 1, "uses": [{ "region": "scope-regulation", "role": "body" }] },
    { "id": "scope-condition-title", "text": "Ocena stanu", "expectedOccurrences": 1, "uses": [{ "region": "scope-condition", "role": "heading", "level": 3 }] },
    { "id": "scope-condition-body", "text": "Przyjrzenie się widocznym śladom zużycia i wcześniejszym pracom, zanim zapadnie decyzja o dalszym postępowaniu.", "expectedOccurrences": 1, "uses": [{ "region": "scope-condition", "role": "body" }] },
    { "id": "scope-next-title", "text": "Przygotowanie do dalszej gry", "expectedOccurrences": 1, "uses": [{ "region": "scope-next", "role": "heading", "level": 3 }] },
    { "id": "scope-next-body", "text": "Ustalenie, które zmiany są potrzebne teraz, a które wymagają dodatkowej obserwacji lub odrębnej rozmowy.", "expectedOccurrences": 1, "uses": [{ "region": "scope-next", "role": "body" }] },
    { "id": "preparation-title", "text": "Przed pierwszą rozmową", "expectedOccurrences": 1, "uses": [{ "region": "preparation", "role": "heading", "level": 2 }] },
    { "id": "preparation-intro", "text": "Nie musisz znać nazwy części, aby opisać problem. Wystarczy własna obserwacja. Te pytania pomagają uporządkować opis; nie są formularzem zgłoszeniowym.", "expectedOccurrences": 1, "uses": [{ "region": "preparation", "role": "body" }] },
    { "id": "preparation-what-title", "text": "Co zauważasz?", "expectedOccurrences": 1, "uses": [{ "region": "preparation-what", "role": "heading", "level": 3 }] },
    { "id": "preparation-what-body", "text": "Opisz, co czujesz lub słyszysz podczas gry i czy dotyczy to całego instrumentu, czy konkretnego miejsca.", "expectedOccurrences": 1, "uses": [{ "region": "preparation-what", "role": "body" }] },
    { "id": "preparation-when-title", "text": "Kiedy pojawiła się zmiana?", "expectedOccurrences": 1, "uses": [{ "region": "preparation-when", "role": "heading", "level": 3 }] },
    { "id": "preparation-when-body", "text": "Przypomnij sobie moment, w którym instrument zaczął zachowywać się inaczej. Jeśli nie wiesz — to także przydatna informacja.", "expectedOccurrences": 1, "uses": [{ "region": "preparation-when", "role": "body" }] },
    { "id": "preparation-history-title", "text": "Co już było robione?", "expectedOccurrences": 1, "uses": [{ "region": "preparation-history", "role": "heading", "level": 3 }] },
    { "id": "preparation-history-body", "text": "Zbierz znane informacje o wcześniejszych regulacjach lub naprawach. Nie trzeba uzupełniać luk domysłami.", "expectedOccurrences": 1, "uses": [{ "region": "preparation-history", "role": "body" }] },
    { "id": "preparation-keep-title", "text": "Co chcesz zachować?", "expectedOccurrences": 1, "uses": [{ "region": "preparation-keep", "role": "heading", "level": 3 }] },
    { "id": "preparation-keep-body", "text": "Wskaż cechę instrumentu, do której jesteś przywiązany. Opis celu jest równie ważny jak opis trudności.", "expectedOccurrences": 1, "uses": [{ "region": "preparation-keep", "role": "body" }] },
    { "id": "preparation-note", "text": "To demonstracja sposobu przedstawienia pracowni. Nie przyjmujemy tu instrumentów, zgłoszeń ani plików i nie prowadzimy wycen.", "expectedOccurrences": 1, "uses": [{ "region": "preparation", "role": "notice" }] },
    { "id": "preparation-action", "text": "Wróć do podejścia", "expectedOccurrences": 1, "uses": [{ "region": "preparation", "role": "link", "href": "#podejscie" }] },
    { "id": "footer-description", "text": "Uważność wobec instrumentu i osoby, która na nim gra.", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "body" }] },
    { "id": "footer-note", "text": "Fikcyjna pracownia i treści demonstracyjne. Strona służy wyłącznie testom Monteby.", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "notice" }] },
    { "id": "footer-action", "text": "Na początek", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "link", "href": "#start" }] }

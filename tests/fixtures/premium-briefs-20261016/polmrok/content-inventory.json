    { "id": "hero-eyebrow", "text": "FIKCYJNY PROGRAM FILMOWY · DEMO QA", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "eyebrow" }] },
    { "id": "hero-title", "text": "Miasto po ostatnim autobusie.", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "heading", "level": 1 }] },
    { "id": "hero-body", "text": "Trzy wyobrażone filmy o tym, co dzieje się między miejscem a wspomnieniem. Ułóż własną drogę przez program — od ruchu, przez oczekiwanie, po ciszę.", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "lead" }] },
    { "id": "hero-action", "text": "Przejdź do programu", "expectedOccurrences": 1, "uses": [{ "region": "opening", "role": "link", "href": "#program" }] },
    { "id": "program-title", "text": "Jeden wieczór. Trzy spojrzenia.", "expectedOccurrences": 1, "uses": [{ "region": "programme-index", "role": "heading", "level": 2 }] },
    { "id": "program-intro", "text": "Kolejność i godziny są częścią fikcyjnego scenariusza. Ta strona nie zapowiada rzeczywistego wydarzenia.", "expectedOccurrences": 1, "uses": [{ "region": "programme-index", "role": "body" }] },
    { "id": "film-one-time", "text": "18:00", "expectedOccurrences": 1, "uses": [{ "region": "programme-index-film-one", "role": "programme-time" }] },
    { "id": "film-one-title", "text": "Ostatni przystanek", "expectedOccurrences": 2, "uses": [{ "region": "programme-index-film-one", "role": "link", "href": "#ostatni-przystanek" }, { "region": "film-one", "role": "heading", "level": 2 }] },
    { "id": "film-two-time", "text": "19:15", "expectedOccurrences": 1, "uses": [{ "region": "programme-index-film-two", "role": "programme-time" }] },
    { "id": "film-two-title", "text": "Światło na czwartym piętrze", "expectedOccurrences": 2, "uses": [{ "region": "programme-index-film-two", "role": "link", "href": "#swiatlo" }, { "region": "film-two", "role": "heading", "level": 2 }] },
    { "id": "film-three-time", "text": "20:30", "expectedOccurrences": 1, "uses": [{ "region": "programme-index-film-three", "role": "programme-time" }] },
    { "id": "film-three-title", "text": "Rzeka poza kadrem", "expectedOccurrences": 2, "uses": [{ "region": "programme-index-film-three", "role": "link", "href": "#rzeka" }, { "region": "film-three", "role": "heading", "level": 2 }] },
    { "id": "film-one-theme", "text": "RUCH / OBSERWACJA", "expectedOccurrences": 1, "uses": [{ "region": "film-one", "role": "eyebrow" }] },
    { "id": "film-one-body", "text": "Nocny autobus kończy trasę, lecz pasażerka nie wysiada od razu. Z okna obserwuje miejsca, które za dnia mija bez uwagi. Ta wyobrażona opowieść zaczyna się tam, gdzie kończy się pośpiech.", "expectedOccurrences": 1, "uses": [{ "region": "film-one", "role": "body" }] },
    { "id": "film-one-action", "text": "Następna opowieść", "expectedOccurrences": 1, "uses": [{ "region": "film-one", "role": "link", "href": "#swiatlo" }] },
    { "id": "film-two-theme", "text": "OCZEKIWANIE / PRZESTRZEŃ", "expectedOccurrences": 1, "uses": [{ "region": "film-two", "role": "eyebrow" }] },
    { "id": "film-two-body", "text": "W oknie po drugiej stronie podwórka codziennie zapala się światło. Mieszkaniec sąsiedniego bloku układa możliwe historie, zanim odważy się przyznać, że nic o ich bohaterach nie wie. Film istnieje tylko w tym fikcyjnym programie.", "expectedOccurrences": 1, "uses": [{ "region": "film-two", "role": "body" }] },
    { "id": "film-two-action", "text": "Przejdź nad rzekę", "expectedOccurrences": 1, "uses": [{ "region": "film-two", "role": "link", "href": "#rzeka" }] },
    { "id": "film-three-theme", "text": "CISZA / PAMIĘĆ", "expectedOccurrences": 1, "uses": [{ "region": "film-three", "role": "eyebrow" }] },
    { "id": "film-three-body", "text": "Dwie osoby wracają na brzeg rzeki, z którego pamiętają różne widoki. Spacer nie rozstrzyga, czyja pamięć jest dokładniejsza. Pozwala obu wersjom pozostać obok siebie.", "expectedOccurrences": 1, "uses": [{ "region": "film-three", "role": "body" }] },
    { "id": "film-three-action", "text": "Wróć do programu", "expectedOccurrences": 1, "uses": [{ "region": "film-three", "role": "link", "href": "#program" }] },
    { "id": "about-title", "text": "O tym cyklu", "expectedOccurrences": 1, "uses": [{ "region": "about", "role": "heading", "level": 2 }] },
    { "id": "about-body", "text": "Półmrok zestawia trzy sposoby patrzenia na miasto. Nie szuka jednego obrazu miejsca: interesuje go różnica między tym, co widać, tym, czego oczekujemy, i tym, co pamiętamy.", "expectedOccurrences": 1, "uses": [{ "region": "about", "role": "body" }] },
    { "id": "reading-title", "text": "Jak czytać ten program", "expectedOccurrences": 1, "uses": [{ "region": "reading", "role": "heading", "level": 2 }] },
    { "id": "reading-body", "text": "Wybierz tytuł w indeksie, aby przejść do jego opisu. Wszystkie teksty są dostępne na tej stronie. Godziny, filmy i cały cykl są fikcyjne; nie prowadzimy sprzedaży biletów ani zapisów.", "expectedOccurrences": 1, "uses": [{ "region": "reading", "role": "body" }] },
    { "id": "footer-description", "text": "Wyobrażony wieczór filmowy o mieście, uwadze i pamięci.", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "body" }] },
    { "id": "footer-note", "text": "Fikcyjny program i treści demonstracyjne. Strona służy wyłącznie testom Monteby.", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "notice" }] },
    { "id": "footer-action", "text": "Na początek", "expectedOccurrences": 1, "uses": [{ "region": "footer", "role": "link", "href": "#start" }] }
